{
  "name": "zoe-closet-pos",
  "version": "0.1.0",
  "description": "Zoe Closet - Sistema local de facturación, inventario y punto de venta (Honduras - SAR)",
  "main": "server/index.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",

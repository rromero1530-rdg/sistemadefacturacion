    "seed:demo": "node server/db/seed-demo.js",
    "backup": "node server/db/backup.js",
    "vendor": "node scripts/vendor.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  }
}

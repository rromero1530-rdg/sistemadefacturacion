# Copia este archivo como .env y ajusta los valores.

# --- Servidor ---
PORT=3000
# 127.0.0.1 = solo esta computadora. Usa 0.0.0.0 para acceder desde otra PC/tablet de la red local.
HOST=127.0.0.1
TIMEZONE=America/Tegucigalpa

# --- Base de datos (archivo VIVO) ---
# Recomendado: disco LOCAL (no OneDrive). OneDrive puede corromper un SQLite abierto.
DB_PATH=./database/data/zoecloset.db

# --- Respaldos automáticos (aquí SÍ va OneDrive) ---
# Si se deja vacío, se usa %OneDrive%\Facturacion\respaldos automáticamente.
# Ejemplo: C:\Users\TuUsuario\OneDrive\Facturacion\respaldos
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=4
BACKUP_KEEP=60
